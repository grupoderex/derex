# ═════════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env.qa or .env.prod and fill in real values
# Deploy:
#   QA:   docker compose --env-file .env.qa   up -d --build
#   PROD: docker compose --env-file .env.prod up -d --build
# ═════════════════════════════════════════════════════════════════════════════

# ─── Domain ───────────────────────────────────────────────────────────────────
# Root domain. Subdomains are derived automatically:
#   https://${DOMAIN}         → Frontend (Next.js)
#   https://api.${DOMAIN}     → Backend  (Express)
#   https://admin.${DOMAIN}   → Admin    (React)
#   https://blog.${DOMAIN}    → Blog     (Strapi)
DOMAIN=yourdomain.com

# ─── Traefik / Let's Encrypt ──────────────────────────────────────────────────
ACME_EMAIL=admin@yourdomain.com

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password_here
MYSQL_DATABASE=derex
MYSQL_STRAPI_DATABASE=derex_strapi
# IMPORTANT: MYSQL_USER must match the user in mysql/init/01-create-databases.sql
MYSQL_USER=derex_user
MYSQL_PASSWORD=change_me_db_password_here

# ─── Backend ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars
RECAPTCHA_SECRET_KEY=change_me_recaptcha_secret
RECAPTCHA_BYPASS=false
NEXT_PUBLIC_REACT_APP_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_MAPS_DEV=false

# Email (nodemailer / SMTP)
EMAIL_USER=no-reply@yourdomain.com
EMAIL_PASS=change_me_email_password
EMAIL_ATENCION_CLIENTE_USER=atencion@yourdomain.com
EMAIL_ATENCION_CLIENTE_PASS=change_me_email_password
EMAIL_PROXIMOS_LANZAMIENTOS_USER=lanzamientos@yourdomain.com
EMAIL_PROXIMOS_LANZAMIENTOS_PASS=change_me_email_password

# Salesforce (leave empty if not used)
SALESFORCE_URL_PREFIX=
SALESFORCE_ORG_ID=

# ─── Strapi ───────────────────────────────────────────────────────────────────
# Generate keys with:
#   node -e "const c=require('crypto'); console.log([1,2,3,4].map(()=>c.randomBytes(16).toString('base64')).join(','))"
STRAPI_APP_KEYS=key1,key2,key3,key4

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRAPI_API_TOKEN_SALT=change_me_api_token_salt
STRAPI_ADMIN_JWT_SECRET=change_me_admin_jwt_secret
STRAPI_TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
STRAPI_JWT_SECRET=change_me_strapi_jwt_secret
STRAPI_BOOTSTRAP_ADMIN_FIRSTNAME=Admin
STRAPI_BOOTSTRAP_ADMIN_LASTNAME=User
STRAPI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
STRAPI_BOOTSTRAP_ADMIN_PASSWORD=change_me_strapi_admin_password
STRAPI_BOOTSTRAP_ADMIN_ONETIME=false
